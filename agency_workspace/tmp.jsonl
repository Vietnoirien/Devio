sing-repository\"\n  },\n  \"dependencies\": {\n    \"@modelcontextprotocol/sdk\": \"^1.29.0\",\n    \"cheerio\": \"^1.2.0\",\n    \"jsonrepair\": \"^3.14.0\",\n    \"react\": \"^18.2.0\",\n    \"react-dom\": \"^18.2.0\",\n    \"ws\": \"^8.21.0\"\n  },\n  \"devDependencies\": {\n    \"@testing-library/dom\": \"^10.4.1\",\n    \"@testing-library/react\": \"^16.3.2\",\n    \"@types/cheerio\": \"^0.22.35\",\n    \"@types/node\": \"^20.11.0\",\n    \"@types/react\": \"^18.2.0\",\n    \"@types/react-dom\": \"^18.2.0\",\n    \"@types/vscode\": \"^1.85.0\",\n    \"@types/ws\": \"^8.18.1\",\n    \"@vitejs/plugin-react\": \"^4.2.0\",\n    \"esbuild\": \"^0.28.1\",\n    \"jsdom\": \"^29.1.1\",\n    \"typescript\": \"^5.3.0\",\n    \"vite\": \"^8.0.16\",\n    \"vitest\": \"^4.1.9\"\n  }\n}\n"}]}
