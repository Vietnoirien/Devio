{
  "name": "devio-antigravity-plugin",
  "displayName": "Devio AI Agency",
  "description": "Devio AI Development Agency IDE Plugin",
  "version": "0.4.3",
  "publisher": "devio",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:devio.start"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "devio.start",
        "title": "Devio: Start AI Agency"
      },
      {
        "command": "devio.setAntigravityLinkToken",
        "title": "Devio: Set Antigravity Link Token"
      }
    ],
    "configuration": {
      "title": "Devio AI Agency",
      "properties": {
        "devio.autonomyMode": {
          "type": "string",
          "enum": ["full", "supervised"],
          "default": "supervised",
          "description": "Engine run mode"
        },
        "devio.antigravityLinkPort": {
          "type": "number",
          "default": 3717,
          "description": "Port Antigravity Link listens on"
        },
        "devio.freshConversationPerTurn": {
          "type": "boolean",
          "default": true,
          "description": "Open fresh chat before each agent turn"
        },
        "devio.newChatSelector": {
          "type": "string",
          "default": "New Chat",
          "description": "Text label or CSS selector for the New Chat button"
        },
        "devio.responseSelector": {
          "type": "string",
          "default": "",
          "description": "CSS selector for extracting last assistant message. Empty = full text content fallback."
        }
      }
    }
  },
  "scripts": {
    "test": "vitest run",
    "build": "node esbuild.js && vite build",
    "build:extension": "node esbuild.js",
    "build:webview": "vite build",
    "package": "npm run build && npx @vscode/vsce package --no-dependencies --allow-missing-repository"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/vscode": "^1.85.0",
    "@vitejs/plugin-react": "^4.2.0",
    "esbuild": "^0.28.1",
    "jsdom": "^29.1.1",
    "typescript": "^5.3.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  }
}
